{
  "name": "stonklaunch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/verify-dependency.mjs && next build --webpack",
    "start": "node scripts/verify-dependency.mjs && next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "indexer": "node scripts/verify-dependency.mjs && node --import tsx src/worker/indexer.ts",
    "verify:dependencies": "node scripts/verify-dependency.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@solana/actions": "1.6.6",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "bn.js": "5.2.5",
    "buffer": "6.0.3",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "framer-motion": "14.3.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
