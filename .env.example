# StonkLaunch v2.1 配置契约 — dot 在 d01/d03 实现解析器后使用。
# 本启动包不包含应用代码，复制本文件不会自动产生站点或链上配置。
# 所有真实凭据留空；不要提交 .env.local，不打印 secret。

# 服务端模式权威来源；前端通过 /api/runtime 获取安全视图。
# demo | devnet | mainnet-readonly | mainnet-live
APP_MODE=demo
APP_ORIGIN=http://localhost:3000

# 私有 RPC URL 仅服务端使用。
SOLANA_RPC_URL=
# 若官方客户端 SDK 需要直连，填允许公开且限制域名的 RPC URL。
# 该值会进入浏览器，禁止粘贴仅供服务端保密的凭据。
NEXT_PUBLIC_SOLANA_RPC_URL=

# cluster/program 由 APP_MODE 和官方地址注册表派生并核验。
# 不提供可由普通请求任意覆盖 programId 的入口。

# 商业目标：默认各 50 bps；LaunchLab units = bps * 100。
LAUNCHLAB_PLATFORM_FEE_BPS=50
LAUNCHLAB_CREATOR_FEE_BPS=50
LAUNCHLAB_SHARE_FEE_BPS=0

# 仅公钥；绝不填私钥、助记词或 keypair JSON。
LAUNCHLAB_PLATFORM_ADMIN=
LAUNCHLAB_PLATFORM_FEE_WALLET=
LAUNCHLAB_PLATFORM_NFT_WALLET=
LAUNCHLAB_PLATFORM_ID=
LAUNCHLAB_CPMM_CONFIG_ID=

# 本次主网 SOL API 观察值：6s1xP3hpbAfFoNtUNF8mfHsjr2Bd97JxFJRWLbL6aHuX。
# 执行时回读目标 cluster 核实后填写；绝不用于 devnet。
LAUNCHLAB_SOL_CONFIG_ID=
# 未经目标集群验证保持空值、界面为待验证。
LAUNCHLAB_USDC_CONFIG_ID=
# xStocks 通过逐 mint 能力注册表管理，不以一条通配开关全部开放。

# 生效需真实 PlatformConfig；仅改 env 不改变链上收款权/费率。
# 协议 tradeFeeRate 来自链上，故不提供可覆盖的“协议费率”变量。
DEFAULT_SLIPPAGE_BPS=50
ENABLE_SOLANA_ACTIONS=false

# Supabase URL/anon key 是浏览器公共配置；RLS 仍必须正确实施。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 以下仅服务端；绝不可加 NEXT_PUBLIC_。
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_ASSET_BUCKET=stonklaunch-assets

# 正式批处理任务凭据；不由 dot 对话或客户端轮询替代生产调度。
CRON_SECRET=
# 设计默认值，实际服务设置需明确并在 d03 验证。
INDEXER_BATCH_SIZE=50
INDEXER_POLL_INTERVAL_MS=10000

# 无 AI key 也可完成首版；不依赖 AI 自动发交易或编造海报收益。
